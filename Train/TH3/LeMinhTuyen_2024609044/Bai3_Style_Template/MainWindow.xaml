<Window x:Class="Bai3_Style_Template.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý sinh viên - Style &amp; Template" Height="490" Width="860"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">

    <Window.Resources>
        
        <ControlTemplate x:Key="NutBoGocTemplate" TargetType="Button">
            <Grid>
                <Border x:Name="nen" CornerRadius="8"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"/>
                <Border x:Name="lopPhu" CornerRadius="8" Background="Black" Opacity="0"/>
                <ContentPresenter Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="lopPhu" Property="Opacity" Value="0.15"/>
                </Trigger>
               
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="lopPhu" Property="Opacity" Value="0.30"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource NutBoGocTemplate}"/>
        </Style>

        <!-- D. Style có khóa, kế thừa Style Button chung -->
        <Style x:Key="NutNguyHiem" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
        </Style>

        <Style x:Key="NutPhu" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#64748B"/>
            <Setter Property="BorderBrush" Value="#475569"/>
        </Style>

       
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#6366F1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="vien" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                           
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="vien" Property="BorderBrush" Value="#4338CA"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="vien" Property="BorderBrush" Value="#1D4ED8"/>
                                <Setter TargetName="vien" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="vien" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E3A8A"/>
            <Setter Property="Padding" Value="0,6,0,2"/>
        </Style>

      
        <Style TargetType="DataGrid">
            <Setter Property="RowHeight" Value="28"/>
            <Setter Property="FontSize" Value="13"/>

            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
            <Setter Property="AlternatingRowBackground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E3A8A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

      
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding XepLoai}" Value="Xuất sắc">
                    <Setter Property="Foreground" Value="#15803D"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding XepLoai}" Value="Yếu">
                    <Setter Property="Foreground" Value="#B91C1C"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

      
        <GroupBox Header="Thông tin sinh viên" Margin="0,0,10,0" Padding="8">
            <StackPanel>
                <Label Content="Mã sinh viên (MSSV):"/>
                <TextBox x:Name="txtMSSV"/>

                <Label Content="Họ tên:"/>
                <TextBox x:Name="txtHoTen"/>

                <Label Content="Điểm trung bình (0 - 10):"/>
                <TextBox x:Name="txtGPA"/>

                <WrapPanel Margin="0,16,0,0">
                    <Button x:Name="btnThem" Content="Thêm" Click="BtnThem_Click"/>
                    <Button x:Name="btnSua" Content="Sửa" Click="BtnSua_Click"/>
                    <Button x:Name="btnXoa" Content="Xóa" Click="BtnXoa_Click"
                            Style="{StaticResource NutNguyHiem}"/>
                    <Button x:Name="btnLamMoi" Content="Làm mới" Click="BtnLamMoi_Click"
                            Style="{StaticResource NutPhu}"/>
                </WrapPanel>
            </StackPanel>
        </GroupBox>

       
        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Label Content="Tìm theo tên / MSSV:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="txtTimKiem" Width="220" Margin="0,0,6,0"/>
                <Button Content="Tìm kiếm" Click="BtnTimKiem_Click" Margin="0"/>

            </StackPanel>

            <TextBlock x:Name="lblTongSo" DockPanel.Dock="Bottom" Margin="0,6,0,0"
                       FontStyle="Italic"/>

            <DataGrid x:Name="dgSinhVien" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False"
                      SelectionChanged="DgSinhVien_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="MSSV" Binding="{Binding MSSV}" Width="100"/>
                    <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="*"/>
                    <DataGridTextColumn Header="Điểm TB" Binding="{Binding GPA, StringFormat=F1}" Width="80"/>
                    <DataGridTextColumn Header="Xếp loại" Binding="{Binding XepLoai}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</Window>