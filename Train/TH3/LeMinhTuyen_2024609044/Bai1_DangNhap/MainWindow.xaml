<Window x:Class="Bai1_DangNhap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập hệ thống" Height="330" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Grid Margin="25,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: tiêu đề -->
            <RowDefinition Height="Auto"/>
            <!-- 1: tên đăng nhập -->
            <RowDefinition Height="Auto"/>
            <!-- 2: mật khẩu -->
            <RowDefinition Height="Auto"/>
            <!-- 3: checkbox -->
            <RowDefinition Height="Auto"/>
            <!-- 4: thông báo lỗi -->
            <RowDefinition Height="Auto"/>
            <!-- 5: các nút -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" Text="HỆ THỐNG QUẢN LÝ SINH VIÊN"
                   FontSize="18" FontWeight="Bold" Foreground="#0078D7"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <Label Grid.Row="1" Content="Tên đăng nhập:" VerticalAlignment="Center"/>
        <TextBox x:Name="txtUser" Grid.Row="1" Grid.Column="1"
                 Height="30" Margin="0,4" VerticalContentAlignment="Center"/>

        <Label Grid.Row="2" Content="Mật khẩu:" VerticalAlignment="Center"/>
        <PasswordBox x:Name="txtPass" Grid.Row="2" Grid.Column="1"
                     Height="30" Margin="0,4" VerticalContentAlignment="Center"/>

        <CheckBox x:Name="chkGhiNho" Grid.Row="3" Grid.Column="1"
                  Content="Ghi nhớ tên đăng nhập" Margin="0,8"/>

        <TextBlock x:Name="lblThongBao" Grid.Row="4" Grid.ColumnSpan="2"
                   Foreground="Red" TextWrapping="Wrap" Margin="0,4"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,12,0,0">
            <!-- IsDefault: nhấn Enter = Click; IsCancel: nhấn Esc = Click -->
            <Button x:Name="btnLogin" Content="Đăng nhập" Width="110" Height="32"
                    IsDefault="True" Margin="0,0,12,0" Click="BtnLogin_Click"/>
            <Button Content="Thoát" Width="110" Height="32"
                    IsCancel="True" Click="BtnThoat_Click"/>
        </StackPanel>
    </Grid>
</Window>