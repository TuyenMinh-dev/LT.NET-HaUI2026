<Window x:Class="Bai2_CRUD_SinhVien.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý sinh viên" Height="470" Width="840"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Cột trái: form nhập liệu -->
        <GroupBox Header="Thông tin sinh viên" Margin="0,0,10,0" Padding="8">
            <StackPanel>
                <Label Content="Mã sinh viên (MSSV):"/>
                <TextBox x:Name="txtMSSV" Height="28"/>

                <Label Content="Họ tên:"/>
                <TextBox x:Name="txtHoTen" Height="28"/>

                <Label Content="Điểm trung bình (0 - 10):"/>
                <TextBox x:Name="txtGPA" Height="28"/>

                <WrapPanel Margin="0,16,0,0">
                    <Button x:Name="btnThem" Content="Thêm" Width="80" Height="30"
                            Margin="0,0,6,6" Click="BtnThem_Click"/>
                    <Button x:Name="btnSua" Content="Sửa" Width="80" Height="30"
                            Margin="0,0,6,6" Click="BtnSua_Click"/>
                    <Button x:Name="btnXoa" Content="Xóa" Width="80" Height="30"
                            Margin="0,0,6,6" Click="BtnXoa_Click"/>
                    <Button x:Name="btnLamMoi" Content="Làm mới" Width="80" Height="30"
                            Margin="0,0,6,6" Click="BtnLamMoi_Click"/>
                </WrapPanel>
            </StackPanel>
        </GroupBox>

        <!-- Cột phải: tìm kiếm + DataGrid -->
        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Label Content="Tìm theo tên / MSSV:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtTimKiem" Width="220" Height="28"/>
                <Button Content="Tìm kiếm" Width="90" Height="28" Margin="6,0,0,0"
                        Click="BtnTimKiem_Click"/>
            </StackPanel>

            <TextBlock x:Name="lblTongSo" DockPanel.Dock="Bottom" Margin="0,6,0,0"
                       FontStyle="Italic"/>

            <!-- Phần tử cuối của DockPanel tự lấp đầy phần còn lại -->
            <DataGrid x:Name="dgSinhVien" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False"
                      SelectionChanged="DgSinhVien_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="MSSV" Binding="{Binding MSSV}" Width="100"/>
                    <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="*"/>
                    <DataGridTextColumn Header="Điểm TB" Binding="{Binding GPA, StringFormat=F1}" Width="80"/>
                    <DataGridTextColumn Header="Xếp loại" Binding="{Binding XepLoai}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</Window>